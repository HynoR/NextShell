{
  "//": "Messages of ICU MessageFormat and what they format to, which package i18n (TestMessageFixtures) and mygo-runtime's formatter (i18n.test.ts) both check, so that Go and pages say the same. Numbers and dates are formatted with CLDR's data in Go and Intl in pages; dates, whose output depends on the time zone, are tested apart.",
  "format": [
    { "message": "Hello", "want": "Hello" },
    { "message": "", "want": "" },
    { "message": "Hello, {name}!", "args": { "name": "Ada" }, "want": "Hello, Ada!" },
    { "message": "Hello, { name }!", "args": { "name": "Ada" }, "want": "Hello, Ada!" },
    { "message": "{a}{b}", "args": { "a": "x", "b": "y" }, "want": "xy" },
    { "message": "{0} and {1}", "args": { "0": "x", "1": "y" }, "want": "x and y" },
    { "message": "Hello, {name}!", "want": "Hello, {name}!" },
    { "message": "Is {ok}", "args": { "ok": true }, "want": "Is true" },
    { "message": "{n} items", "args": { "n": 5 }, "want": "5 items" },
    { "message": "{n} items", "args": { "n": 2.5 }, "want": "2.5 items" },
    { "message": "{n} items", "args": { "n": "1.50" }, "want": "1.50 items" },
    { "message": "{n, number}", "args": { "n": -3 }, "want": "-3" },
    { "message": "{n, number, percent}", "args": { "n": 0.25 }, "want": "25%" },
    { "message": "{n, number, integer}", "args": { "n": 2.5 }, "want": "2" },
    { "message": "{n, number, integer}", "args": { "n": 3.5 }, "want": "4" },
    { "message": "{n, number}", "args": { "n": "many" }, "want": "many" },
    { "message": "{n}", "args": { "n": 1234.5 }, "want": "1,234.5" },
    { "message": "{n}", "locale": "de", "args": { "n": 1234.5 }, "want": "1.234,5" },
    { "message": "{n}", "locale": "hi", "args": { "n": 1234567 }, "want": "12,34,567" },
    { "message": "{n}", "locale": "es", "args": { "n": 1234 }, "want": "1234" },
    { "message": "{n}", "locale": "es", "args": { "n": 12345 }, "want": "12.345" },
    { "message": "{n}", "args": { "n": 2.0005 }, "want": "2.001" },
    { "message": "{n, number}", "args": { "n": "1234.50" }, "want": "1,234.50" },
    { "message": "{n, number, percent}", "locale": "de", "args": { "n": 0.25 }, "want": "25\u00a0%" },
    { "message": "{n, number, ::.00}", "args": { "n": 1.5 }, "want": "1.50" },
    { "message": "{n, number, ::percent .0}", "args": { "n": 0.256 }, "want": "25.6%" },
    { "message": "{n, number, ::group-off}", "args": { "n": 12345 }, "want": "12345" },
    { "message": "{price, number, ::currency/EUR}", "locale": "de", "args": { "price": 1842 }, "want": "1.842,00\u00a0€" },
    { "message": "{price, number, ::currency/USD}", "args": { "price": -1842.5 }, "want": "-$1,842.50" },
    { "message": "{price, number, ::currency/JPY}", "args": { "price": 1842 }, "want": "¥1,842" },
    { "message": "{price, number, ::currency/EUR}", "args": { "price": "1.5" }, "want": "€1.50" },
    { "message": "{price, number, ::currency/EUR .0}", "args": { "price": 1.25 }, "want": "€1.3" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": 1.0004 }, "want": "1 file" },
    { "message": "{n, plural, one {# Datei} other {# Dateien}}", "locale": "de", "args": { "n": 1000 }, "want": "1.000 Dateien" },

    { "message": "don't", "want": "don't" },
    { "message": "don''t", "want": "don't" },
    { "message": "''", "want": "'" },
    { "message": "'", "want": "'" },
    { "message": "a'b", "want": "a'b" },
    { "message": "'{'", "want": "{" },
    { "message": "'}'", "want": "}" },
    { "message": "'{name}'", "args": { "name": "Ada" }, "want": "{name}" },
    { "message": "'{name}' is {name}", "args": { "name": "Ada" }, "want": "{name} is Ada" },
    { "message": "'{it''s}'", "want": "{it's}" },
    { "message": "'{unterminated", "want": "{unterminated" },
    { "message": "# is #", "want": "# is #" },
    { "message": "'#'", "want": "'#'" },
    { "message": "{n, plural, other {'#' is #}}", "args": { "n": 3 }, "want": "# is 3" },
    { "message": "{n, plural, other {'{'#'}'}}", "args": { "n": 3 }, "want": "{3}" },
    { "message": "{n, plural, other {it''s #}}", "args": { "n": 3 }, "want": "it's 3" },
    { "message": "{n, plural, other {it's #}}", "args": { "n": 3 }, "want": "it's 3" },

    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": 1 }, "want": "1 file" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": 0 }, "want": "0 files" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": 2 }, "want": "2 files" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": "1.0" }, "want": "1.0 files" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": 1.5 }, "want": "1.5 files" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": -1 }, "want": "-1 file" },
    { "message": "{n, plural, =0 {No files} one {# file} other {# files}}", "args": { "n": 0 }, "want": "No files" },
    { "message": "{n, plural, =1 {Exactly one} one {# file} other {# files}}", "args": { "n": 1 }, "want": "Exactly one" },
    { "message": "{n, plural, =1 {Exactly one} other {# files}}", "args": { "n": "1.0" }, "want": "Exactly one" },
    { "message": "{n, plural, =1.5 {One and a half} other {# files}}", "args": { "n": 1.5 }, "want": "One and a half" },
    { "message": "{n, plural, =1 {Exactly one} other {# files}}", "args": { "n": -1 }, "want": "-1 files" },
    { "message": "{ n , plural , one { # file } other { # files } }", "args": { "n": 1 }, "want": " 1 file " },
    { "message": "{n,plural,one{# file}other{# files}}", "args": { "n": 7 }, "want": "7 files" },
    { "message": "{n, plural, one {# file} other {# files}}", "args": { "n": "lots" }, "want": "lots files" },
    { "message": "{n, plural, one {# file} other {# files}}", "want": "{n}" },
    { "message": "{n, plural, few {few} other {other}}", "locale": "en", "args": { "n": 3 }, "want": "other" },

    { "message": "{n, plural, one {# файл} few {# файла} many {# файлов} other {# файла}}", "locale": "ru", "args": { "n": 1 }, "want": "1 файл" },
    { "message": "{n, plural, one {# файл} few {# файла} many {# файлов} other {# файла}}", "locale": "ru", "args": { "n": 3 }, "want": "3 файла" },
    { "message": "{n, plural, one {# файл} few {# файла} many {# файлов} other {# файла}}", "locale": "ru", "args": { "n": 11 }, "want": "11 файлов" },
    { "message": "{n, plural, one {# файл} few {# файла} many {# файлов} other {# файла}}", "locale": "ru", "args": { "n": 21 }, "want": "21 файл" },
    { "message": "{n, plural, one {# файл} few {# файла} many {# файлов} other {# файла}}", "locale": "ru", "args": { "n": 22 }, "want": "22 файла" },
    { "message": "{n, plural, zero {zero} one {one} two {two} few {few} many {many} other {other}}", "locale": "ar", "args": { "n": 0 }, "want": "zero" },
    { "message": "{n, plural, zero {zero} one {one} two {two} few {few} many {many} other {other}}", "locale": "ar", "args": { "n": 2 }, "want": "two" },
    { "message": "{n, plural, zero {zero} one {one} two {two} few {few} many {many} other {other}}", "locale": "ar", "args": { "n": 105 }, "want": "few" },
    { "message": "{n, plural, zero {zero} one {one} two {two} few {few} many {many} other {other}}", "locale": "ar", "args": { "n": 111 }, "want": "many" },
    { "message": "{n, plural, one {# fichier} many {# de fichiers} other {# fichiers}}", "locale": "fr", "args": { "n": 0 }, "want": "0 fichier" },
    { "message": "{n, plural, other {# 个文件}}", "locale": "zh-Hans", "args": { "n": 1 }, "want": "1 个文件" },
    { "message": "{n, plural, one {# file} other {# files}}", "locale": "zh-Hant-TW", "args": { "n": 1 }, "want": "1 files" },

    { "message": "{n, plural, offset:1 =0 {Nobody} =1 {{host}} one {{host} and # other} other {{host} and # others}}", "args": { "n": 0, "host": "Ada" }, "want": "Nobody" },
    { "message": "{n, plural, offset:1 =0 {Nobody} =1 {{host}} one {{host} and # other} other {{host} and # others}}", "args": { "n": 1, "host": "Ada" }, "want": "Ada" },
    { "message": "{n, plural, offset:1 =0 {Nobody} =1 {{host}} one {{host} and # other} other {{host} and # others}}", "args": { "n": 2, "host": "Ada" }, "want": "Ada and 1 other" },
    { "message": "{n, plural, offset:1 =0 {Nobody} =1 {{host}} one {{host} and # other} other {{host} and # others}}", "args": { "n": 5, "host": "Ada" }, "want": "Ada and 4 others" },
    { "message": "{n, plural, offset:2 other {#}}", "args": { "n": "3.50" }, "want": "1.50" },

    { "message": "{n, selectordinal, one {#st} two {#nd} few {#rd} other {#th}}", "args": { "n": 1 }, "want": "1st" },
    { "message": "{n, selectordinal, one {#st} two {#nd} few {#rd} other {#th}}", "args": { "n": 22 }, "want": "22nd" },
    { "message": "{n, selectordinal, one {#st} two {#nd} few {#rd} other {#th}}", "args": { "n": 103 }, "want": "103rd" },
    { "message": "{n, selectordinal, one {#st} two {#nd} few {#rd} other {#th}}", "args": { "n": 111 }, "want": "111th" },
    { "message": "{n, selectordinal, =1 {first} one {#st} other {#th}}", "args": { "n": 1 }, "want": "first" },
    { "message": "{n, selectordinal, other {#.}}", "locale": "de", "args": { "n": 3 }, "want": "3." },

    { "message": "{g, select, female {She} male {He} other {They}} replied.", "args": { "g": "female" }, "want": "She replied." },
    { "message": "{g, select, female {She} male {He} other {They}} replied.", "args": { "g": "robot" }, "want": "They replied." },
    { "message": "{g, select, female {She} male {He} other {They}} replied.", "args": { "g": "" }, "want": "They replied." },
    { "message": "{g, select, female {She} male {He} other {They}} replied.", "want": "{g} replied." },
    { "message": "{ok, select, true {Yes} false {No} other {?}}", "args": { "ok": true }, "want": "Yes" },
    { "message": "{ok, select, true {Yes} false {No} other {?}}", "args": { "ok": false }, "want": "No" },
    { "message": "{n, select, 1 {one} other {other}}", "args": { "n": 1 }, "want": "one" },
    { "message": "{g, select, other {#}}", "args": { "g": "x" }, "want": "#" },

    { "message": "{g, select, female {{n, plural, one {She has # file} other {She has # files}}} other {{n, plural, one {They have # file} other {They have # files}}}}", "args": { "g": "female", "n": 1 }, "want": "She has 1 file" },
    { "message": "{g, select, female {{n, plural, one {She has # file} other {She has # files}}} other {{n, plural, one {They have # file} other {They have # files}}}}", "args": { "g": "x", "n": 4 }, "want": "They have 4 files" },
    { "message": "{n, plural, one {{g, select, female {# woman} other {# person #}}} other {# people}}", "args": { "g": "female", "n": 1 }, "want": "# woman" },
    { "message": "{n, plural, one {{g, select, female {# woman} other {# person}}} other {{m, plural, one {# of #} other {#s}}}}", "args": { "g": "x", "n": 5, "m": 1 }, "want": "1 of 1" },
    { "message": "{n, plural, one {a {n} b} other {c {n} d #}}", "args": { "n": 2 }, "want": "c 2 d 2" }
  ],
  "errors": [
    "{",
    "}",
    "a } b",
    "{}",
    "{ }",
    "{name",
    "{name, }",
    "{name, foo}",
    "{name, number, }",
    "{name, number",
    "{n, plural}",
    "{n, plural,}",
    "{n, plural, one {x}}",
    "{n, plural, single {x} other {y}}",
    "{n, plural, one {x} one {y} other {z}}",
    "{n, plural, =x {a} other {b}}",
    "{n, plural, = 1 {a} other {b}}",
    "{n, plural, one x other {y}}",
    "{n, plural, one {x} other {y}",
    "{n, plural, offset: {x} other {y}}",
    "{n, select, a {x}}",
    "{n, select, a {x} a {y} other {z}}",
    "{n, select, other {x} {y}}",
    "{01}",
    "{a-b}",
    "{n, plural, other {{}}}"
  ],
  "pseudo": [
    { "message": "Select files", "locale": "en-XA", "want": "[Šéļéçţ ƒîļéš one two]" },
    { "message": "Hello, {name}!", "locale": "en-XA", "args": { "name": "Ada" }, "want": "[Ĥéļļö, Ada! one]" },
    { "message": "{n, plural, one {# file} other {# files}}", "locale": "en-XA", "args": { "n": 2 }, "want": "[2 ƒîļéš one]" },
    { "message": "Select files", "locale": "ar-XB", "want": "\u200f\u202eSelect\u202c\u200f \u200f\u202efiles\u202c\u200f" },
    { "message": "Hi {name}", "locale": "ar-XB", "args": { "name": "Ada" }, "want": "\u200f\u202eHi\u202c\u200f \u200fAda\u200f" }
  ]
}
