{
  "name": "nextshell",
  "version": "0.1.6",
  "private": true,
  "description": "NextShell desktop prototype workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm run rebuild:native",
    "rebuild:native": "pnpm --filter @nextshell/desktop run rebuild:native",
    "rebuild:native:node": "pnpm --recursive rebuild better-sqlite3 keytar cpu-features ssh2",
    "dev": "pnpm run rebuild:native && pnpm --filter @nextshell/desktop run dev",
    "build": "pnpm --filter @nextshell/desktop run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @nextshell/desktop run typecheck && pnpm run typecheck:packages",
    "typecheck:packages": "pnpm --filter \"./packages/**\" --recursive --if-present run typecheck",
    "test": "vitest run"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.15.1",
  "overrides": {
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
